{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "cmake",
      "command": "build",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Flash & Run",
      "type": "shell",
      "command": "${env:CUBE_BUNDLE_PATH}/programmer/2.23.0/bin/STM32_Programmer_CLI",
      "args": [
        "-c",
        "port=SWD",
        "mode=UR",
        "-w",
        "${workspaceFolder}/build/Debug/atoBenchBoard.elf",
        "-v",
        "-rst"
      ],
      "dependsOn": "Build",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
